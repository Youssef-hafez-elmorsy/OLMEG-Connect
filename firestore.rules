rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    function claimRole() {
      return signedIn() ? request.auth.token.role : null;
    }

    function hasRole(role) {
      return signedIn() && (
        claimRole() == role ||
        (
          request.auth.token.roles is list &&
          role in request.auth.token.roles
        )
      );
    }

    function isModerator() {
      return hasRole('moderator') || isAdmin() || isSuperAdmin();
    }

    function isSupport() {
      return hasRole('support') || isAdmin() || isSuperAdmin();
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.role == 'super_admin' ||
        (
          request.auth.token.roles is list &&
          'super_admin' in request.auth.token.roles
        )
      );
    }

    function isAdminStaff() {
      return isModerator() || isSupport() || isAdmin() || isSuperAdmin();
    }

    function isApprovedMerchant() {
      return signedIn() &&
        userDoc().data.accountType == 'merchant' &&
        userDoc().data.merchantVerificationStatus == 'approved';
    }

    function isOrderParticipant() {
      return signedIn() &&
        (
          resource.data.buyerId == request.auth.uid ||
          request.auth.uid in resource.data.sellerIds ||
          isAdmin()
        );
    }

    function isOrderBuyer() {
      return signedIn() && resource.data.buyerId == request.auth.uid;
    }

    function isOrderSeller() {
      return signedIn() && request.auth.uid in resource.data.sellerIds;
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function ownerUserUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'roles',
        'admin',
        'adminStaff',
        'accountType',
        'merchantVerificationStatus',
        'isApprovedMerchant',
        'accountStatus',
        'postingRestricted',
        'chatMuted',
        'deletedAt',
      ]);
    }

    function validOrderCreate() {
      return request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.status == 'pendingPayment' &&
        request.resource.data.payment.status in ['pending', 'notStarted'] &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.sellerIds is list &&
        request.resource.data.total is number &&
        request.resource.data.total > 0;
    }

    function validBuyerOrderUpdate() {
      return isOrderBuyer() &&
        onlyChanged(['status', 'updatedAt']) &&
        resource.data.status == 'pendingPayment' &&
        request.resource.data.status == 'cancelled';
    }

    function validSellerOrderUpdate() {
      return isOrderSeller() &&
        onlyChanged(['status', 'updatedAt']) &&
        resource.data.status in ['paid', 'preparing', 'shipped'] &&
        request.resource.data.status in ['preparing', 'shipped', 'delivered'];
    }

    function isChatParticipant() {
      return signedIn() &&
        (
          request.auth.uid in resource.data.participants ||
          isAdminStaff()
        );
    }

    function isChatCreateParticipant() {
      return signedIn() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminStaff();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && ownerUserUpdateIsSafe());
      allow delete: if isAdmin();

      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId);
      }

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /merchant_verifications/{userId} {
      allow create: if isOwner(userId) &&
        request.resource.data.status == 'submitted';
      allow read: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn() &&
        (
          resource.data.status == 'active' ||
          resource.data.moderationStatus == 'approved' ||
          resource.data.sellerId == request.auth.uid ||
          isAdmin()
        );
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && (isApprovedMerchant() || isAdmin());
      allow update: if signedIn()
        && (
          resource.data.sellerId == request.auth.uid ||
          isModerator()
        );
      allow delete: if signedIn()
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /product_submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.sellerId == request.auth.uid || isModerator());
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if isChatCreateParticipant()
        && request.resource.data.buyerId is string
        && request.resource.data.sellerId is string;
      allow read, update: if isChatParticipant();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && validOrderCreate();
      allow read: if isOrderParticipant();
      allow update: if isAdmin() || validBuyerOrderUpdate() || validSellerOrderUpdate();
      allow delete: if isAdmin();
    }

    match /sellerProfiles/{sellerId} {
      allow read: if signedIn();
      allow create, update: if isOwner(sellerId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if signedIn() &&
        (resource.data.status == 'visible' || resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn()
        && (
          resource.data.reporterId == request.auth.uid ||
          isModerator() ||
          isSupport()
        );
      allow update: if isModerator() || isSupport();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /admin_roles/{userId} {
      allow read: if isSuperAdmin() || (isAdminStaff() && userId == request.auth.uid);
      // role assignment: only super_admin may write role metadata; Custom
      // Claims must still be changed by a trusted backend/admin process.
      allow write: if isSuperAdmin();
    }

    match /audit_logs/{auditId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin() || isSuperAdmin();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    match /admin_role_requests/{requestId} {
      allow read, write: if isSuperAdmin();
    }

    match /admin_summaries/{summaryId} {
      allow read: if isAdminStaff();
      allow write: if false;
    }

    match /admin_settings/{settingId} {
      allow read, write: if isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if signedIn();
      allow read, update: if isSupport() || isAdmin();
      allow delete: if isAdmin();
    }

    match /refunds/{refundId} {
      allow create: if signedIn();
      allow read, update: if isSupport() || isAdmin();
      allow delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read, write: if isAdmin();
    }

    match /risk_cases/{caseId} {
      allow read, write: if isAdmin();
    }

    match /ai_moderation_reviews/{reviewId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /paymob_webhooks/{webhookId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /payment_reconciliations/{reconciliationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /favorites/{favoriteId} {
      allow read, write: if signedIn()
        && (
          request.resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
